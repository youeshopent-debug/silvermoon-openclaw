{
  "name": "openclaw",
  "version": "2026.5.27",
  "description": "Multi-channel AI gateway with extensible messaging integrations",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openclaw/openclaw.git"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "canvas": "^3.2.3",
    "crawlee": "^3.16.0",
    "discord.js": "^14.26.2",
    "dotenv": "^17.4.2",
    "https-proxy-agent": "^9.0.0",
    "node-cron": "^4.2.1",
    "node-telegram-bot-api": "^0.67.0",
    "nodemailer": "^8.0.7",
    "pdfkit": "^0.18.0",
    "playwright": "^1.59.1",
    "puppeteer": "^24.42.0",
    "undici": "^8.1.0"
  },
  "scripts": {
    "start": "node main.js",
    "dev": "node --watch main.js",
    "test": "node scripts/run-tests.js",
    "test:vitest": "vitest run --project silvermoon",
    "test:vitest:watch": "vitest --project silvermoon",
    "test:vitest:coverage": "vitest run --project silvermoon --coverage",
    "test:vitest:all": "vitest run",
    "lint": "node scripts/lint-check.js",
    "backup": "node scripts/auto-backup.js",
    "logs:rotate": "node scripts/log-rotate.js",
    "ci": "npm test && npm run lint",
    "test:coverage": "node scripts/run-tests.js --coverage",
    "ci:full": "npm test && npm run lint && npm run test:coverage",
    "hooks:install": "node .githooks/setup-hooks.cjs"
  },
  "devDependencies": {
    "vitest": "^4.1.7"
  }
}
